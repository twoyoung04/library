server {
    listen 80;
    server_name ${TEMP_ACCESS_IP};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://${TEMP_ACCESS_IP}$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name ${TEMP_ACCESS_IP};
    ssl_certificate /etc/letsencrypt/live/library-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/library-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    location /static/ { alias /srv/static/; expires 7d; }
    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 130s;
    }
}
