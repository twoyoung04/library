# Copy to project root .env; chmod 600 .env. Use hex passwords to avoid URL/Compose escaping.
# Choose source PostgreSQL major version, initially supported here: 14-17.
# PostgreSQL 18+ requires adapting its Docker volume layout before initialization.
POSTGRES_MAJOR=
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DOMAIN=
NGINX_MODE=http
SHOWAPI_APP_KEY=
JUHE_ISBN_KEY=

COS_ENABLED=0
COS_BUCKET=cover-1307828558
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# Optional: change to a public HTTPS CDN/custom domain without modifying object keys.
COS_PUBLIC_BASE_URL=https://cover-1307828558.cos.ap-shanghai.myqcloud.com
