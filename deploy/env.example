# Copy to project root .env; chmod 600 .env. Use hex passwords to avoid URL/Compose escaping.
# Choose source PostgreSQL major version, initially supported here: 14-17.
# PostgreSQL 18+ requires adapting its Docker volume layout before initialization.
POSTGRES_MAJOR=
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DOMAIN=
NGINX_MODE=http
SHOWAPI_APP_KEY=
JUHE_ISBN_KEY=
# 可选。已获授权的中文书目 HTTPS CSV 地址。
BIBLIOGRAPHY_FEED_URL=
# 可选。设为 1 时补充 Open Library 中文书目及现有藏书缺项。
BIBLIOGRAPHY_OPEN_LIBRARY=0

COS_ENABLED=0
COS_BUCKET=cover-1307828558
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# Optional: change to a public HTTPS CDN/custom domain without modifying object keys.
COS_PUBLIC_BASE_URL=https://cover-1307828558.cos.ap-shanghai.myqcloud.com

# Mobile accounts. Keep real values only in the production .env.
MOBILE_EMAIL_ENABLED=0
LIBRARY_SMTP_HOST=localhost
LIBRARY_SMTP_PORT=587
LIBRARY_SMTP_USER=
LIBRARY_SMTP_PASSWORD=
LIBRARY_SMTP_SSL=0
LIBRARY_EMAIL_FROM=accounts@wuminglib.site
LIBRARY_APPLE_CLIENT_ID=site.wuminglib.mylibrary
LIBRARY_APPLE_TEAM_ID=
LIBRARY_APPLE_KEY_ID=
# Paste the single-line PEM with literal \n between lines.
LIBRARY_APPLE_PRIVATE_KEY=
